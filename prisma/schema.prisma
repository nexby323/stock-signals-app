// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Our comments:
// this file tells prisma how to build the DB (Migrations)
// and it will acsses the DB via the Direct Url because it cant "wait in line" and go thorugh the connection pooler

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           Int    @id @default(autoincrement())
  email        String @unique
  passwordHash String
  
}
